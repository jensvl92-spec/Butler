# OpenRouter API (unified access to all models)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ===========================================
# INTEGRATION API KEYS
# ===========================================

# Weather - OpenWeather (https://openweathermap.org/api)
# Free tier: 1000 calls/day
OPENWEATHER_API_KEY=your-openweather-api-key

# Default location for weather queries
DEFAULT_LOCATION=Bangkok

# Tasks - Todoist (https://todoist.com/prefs/integrations)
TODOIST_API_TOKEN=your-todoist-api-token

# Navigation - Google Maps (https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===========================================
# OAUTH CREDENTIALS (for user authentication)
# ===========================================

# Google OAuth (Calendar, Gmail)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Spotify OAuth
# Create at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
